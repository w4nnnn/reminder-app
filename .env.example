# App Configuration
NODE_ENV=development

# Database Configuration (Better SQLite3)
DATABASE_URL=sqlite.db

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-strong-secret-key-here # Use `openssl rand -base64 32` to generate

# Resend Email Configuration (Required for Email Verification OTP)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev # Or your verified custom domain
